# Email настройки для отправки почты
# Скопируйте этот файл в .env и заполните своими данными
# cp .env.example .env

# Бэкенд для отправки почты (по умолчанию: консоль для development)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP сервер (примеры: smtp.gmail.com, smtp.yandex.ru, smtp.mail.ru)
EMAIL_HOST=smtp.gmail.com

# Порт SMTP (обычно 587 для TLS или 465 для SSL)
EMAIL_PORT=587

# Использовать TLS (True/False)
EMAIL_USE_TLS=True

# Использовать SSL (True/False) - обычно используется вместо TLS
EMAIL_USE_SSL=False

# Email пользователя для авторизации на SMTP сервере
EMAIL_HOST_USER=your-email@gmail.com

# Пароль приложения (для Gmail нужен App Password, не обычный пароль)
# Для Gmail: https://support.google.com/accounts/answer/185833
# Для Yandex: https://yandex.ru/support/id/authorization/app-passwords.html
EMAIL_HOST_PASSWORD=your-app-password

# Email отправителя (обычно тот же что и EMAIL_HOST_USER)
DEFAULT_FROM_EMAIL=your-email@gmail.com
